# =============================================================================
# AMASS - Autonomous Multi-Agent Security System
# Environment Configuration Template
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=AMASS
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Backend API (Express)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Frontend (React/Vite)
# -----------------------------------------------------------------------------
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001
VITE_AGENTS_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# AI Agents Service (FastAPI)
# -----------------------------------------------------------------------------
AGENTS_HOST=0.0.0.0
AGENTS_PORT=8000
AGENTS_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=amass
POSTGRES_PASSWORD=amass_secret_change_in_production
POSTGRES_DB=amass
DATABASE_URL=postgresql://amass:amass_secret_change_in_production@postgres:5432/amass?schema=public

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_in_production
REDIS_URL=redis://:redis_secret_change_in_production@redis:6379

# Redis key prefixes (future use)
REDIS_PREFIX_AMASS=amass:
REDIS_TTL_CACHE=3600
REDIS_TTL_SESSION=86400

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=amass_embeddings

# -----------------------------------------------------------------------------
# LLM / AI — free-first provider abstraction
# -----------------------------------------------------------------------------
# Preferred provider order: 1) Gemini  2) OpenRouter  3) Groq  4) Mistral.
# Only the configured provider(s) need keys — free/low-cost inference, no
# paid provider is a hard dependency. Gemini is the default.
#
# Primary provider (LLM_PRIMARY_PROVIDER, when set, overrides LLM_PROVIDER):
LLM_PROVIDER=gemini
# Explicit primary override (optional; wins over LLM_PROVIDER).
LLM_PRIMARY_PROVIDER=
# Model. For OpenRouter keep the free routing alias; for every other provider
# name a concrete model via LLM_MODEL or the per-provider *_MODEL below
# (free-model availability changes — don't assume one stays forever).
LLM_MODEL=openrouter/free
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
# Optional, bounded fallback escalation order (comma separated,
# e.g. openrouter,groq,mistral). Falls back only on transient failures
# (rate-limit / outage / model-unavailable / timeout) — never on bad keys.
LLM_FALLBACK_PROVIDERS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=

# -----------------------------------------------------------------------------
# Embeddings + security-knowledge RAG (free-first; SEPARATE from the LLM axis)
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER is an independent configuration line from LLM_PROVIDER —
# embeddings NEVER reuse the LLM providers/substrate. Default: Gemini's
# OpenAI-compatible embeddings endpoint (key = GEMINI_API_KEY above).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Vector store for CVE knowledge (single collection amass_security_knowledge).
# Leave unset to reuse the QDRANT_* host/port below.
KNOWLEDGE_QDRANT_URL=
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_COLLECTION=amass_security_knowledge
KNOWLEDGE_QDRANT_TIMEOUT_MS=15000

# NVD ingestion (official NIST v2.0 API; bounded by design).
KNOWLEDGE_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
KNOWLEDGE_NVD_PAGE_SIZE=200
KNOWLEDGE_NVD_MAX_PAGES=5
KNOWLEDGE_NVD_TIMEOUT_MS=30000
KNOWLEDGE_NVD_MAX_RETRIES=2
KNOWLEDGE_NVD_RETRY_DELAY_MS=1000

# RAG search bounds.
RAG_TOP_K_MAX=50
RAG_DEFAULT_TOP_K=5

# Optional override for the prompt template directory
# (default: <repo>/backend/agents/prompts).
PROMPTS_ROOT=

# -----------------------------------------------------------------------------
# LangGraph / LangChain (Future Phase)
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=amass

# -----------------------------------------------------------------------------
# Repository Analyzer
# -----------------------------------------------------------------------------
# Workspace where cloned repositories are analyzed (defaults to a tmp dir)
# ANALYZER_WORKSPACE_DIR=/tmp/amass/repositories
ANALYZER_CLONE_TIMEOUT_MS=120000
ANALYZER_MAX_REPO_BYTES=2147483648
ANALYZER_KEEP_REPO_DIR=false

# -----------------------------------------------------------------------------
# SQLite / TOML / YAML manifest parsing (future phases)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Security (Future Phase)
# -----------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Docker Compose overrides (host machine access)
# -----------------------------------------------------------------------------
# Use these when running services locally outside Docker
# POSTGRES_HOST=localhost
# REDIS_HOST=localhost
# QDRANT_HOST=localhost
# DATABASE_URL=postgresql://amass:amass_secret_change_in_production@localhost:5432/amass?schema=public
# REDIS_URL=redis://:redis_secret_change_in_production@localhost:6379
# QDRANT_URL=http://localhost:6333

# --- Static Scanner ---
SCANNER_DEFAULT_TIMEOUT_MS=60000
SCANNER_SEVERITY_THRESHOLD=INFO
# Static-scan execution runtime: 'sandboxed' runs each scan in a manager
# sandbox (default); 'classic' uses the preparer-cloned ScanService.
STATIC_SCAN_RUNTIME=sandboxed
# Sandbox backend: 'process' = local headless (default); 'docker' = hardened
# long-lived containers on a Docker host.
SANDBOX_RUNTIME=process
# --- Runtime Sandbox Lifecycle (Phase 6) ---
# Bounded resource envelope and timeouts — nothing here may be unlimited.
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_PIDS_LIMIT=256
# Overall lifetime before a runtime sandbox is expired/reclaimed.
SANDBOX_TIMEOUT=1800000
SANDBOX_BUILD_TIMEOUT=300000
SANDBOX_START_TIMEOUT=60000
SANDBOX_HEALTH_TIMEOUT=30000
# Max concurrently live runtime sandboxes (bounded, never unlimited).
SANDBOX_MAX_CONCURRENT=3
# Localhost-only host-port publishing requires explicit opt-in.
SANDBOX_ALLOW_HOST_EXPOSE=false
SCANNER_BANDIT_ENABLED=true
SCANNER_BANDIT_TIMEOUT_MS=
SCANNER_BANDIT_ARGS=
SCANNER_SEMGREP_ENABLED=true
SCANNER_SEMGREP_TIMEOUT_MS=
SCANNER_SEMGREP_ARGS=
SCANNER_NPM_AUDIT_ENABLED=true
SCANNER_NPM_AUDIT_TIMEOUT_MS=
SCANNER_NPM_AUDIT_ARGS=
SCANNER_PIP_AUDIT_ENABLED=true
SCANNER_PIP_AUDIT_TIMEOUT_MS=
SCANNER_PIP_AUDIT_ARGS=

# --- Scout Agent (recon) ---
# Overall per-run stall budget (ms); phases that exceed it finalize early.
SCOUT_TIMEOUT_MS=180000
# Max pages crawled / link depth for the same-origin crawler.
SCOUT_MAX_PAGES=100
SCOUT_MAX_DEPTH=3
# Per HTTP probe timeout (health, crawl, common-path probing).
SCOUT_PROBE_TIMEOUT_MS=5000
# Port enumeration via the nmap adapter (degrades to none when nmap is absent).
SCOUT_PORT_SCAN_ENABLED=true
# Probe well-known paths (/admin, /api, /graphql, /upload, /docs, ...).
SCOUT_PROBE_COMMON_PATHS=true

# --- Sniper Agent (exploit verification) ---
# Hard timeout for ONE verification attempt (sqlmap run).
SNIPER_ATTEMPT_TIMEOUT_MS=120000
# Upper bound of attempts per target for transient failures only.
SNIPER_MAX_ATTEMPTS=2
# Bounded concurrency across planned targets.
SNIPER_CONCURRENCY=2
# Delay between retried attempts (ms).
SNIPER_RETRY_DELAY_MS=1500
# Stored tool-output summary cap (bytes; truncated + redacted).
SNIPER_STORE_SUMMARY_BYTES=4000
# Max tool output lines kept in memory while parsing.
SNIPER_MAX_OUTPUT_LINES=2000
