generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum VulnerabilitySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum VulnerabilityStatus {
  DETECTED
  CONFIRMED
  EXPLOITABLE
  PATCHED
  FALSE_POSITIVE
  ACCEPTED
}

/// Sniper Agent verification states. Deliberately NOT a boolean: a tool
/// that could not run (FAILED) is different from one that ran and found
/// nothing (NOT_CONFIRMED), and missing prerequisites (NOT_TESTED /
/// INCONCLUSIVE) are explicit.
enum ExploitStatus {
  NOT_TESTED
  TESTING
  CONFIRMED
  NOT_CONFIRMED
  INCONCLUSIVE
  FAILED
}

enum PatchStatus {
  GENERATED
  UNDER_REVIEW
  APPROVED
  VALIDATED
  APPLIED
  REJECTED
  FAILED
}

enum CriticStatus {
  APPROVED
  REJECTED
  FAILED
}

enum AgentType {
  SCOUT
  SNIPER
  ENGINEER
  CRITIC
}

enum AgentExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

/// Runtime Sandbox Lifecycle (Phase 6) — a RUNNING, containerized
/// application provisioned for a scan, distinct from the analysis sandbox.
enum RuntimeSandboxStatus {
  CREATING
  BUILDING
  STARTING
  HEALTH_CHECKING
  READY
  FAILED
  DESTROYING
  DESTROYED
  EXPIRED
}

enum RepositoryProvider {
  GITHUB
  GITLAB
  BITBUCKET
  LOCAL
}

// =============================================================================
// Models
// =============================================================================

/// A security scan session targeting one or more repositories
model Scan {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      ScanStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  /// Per-scanner run statistics (static scanner phase).
  scannerStats Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  repositories     ScanRepository[]
  vulnerabilities  Vulnerability[]
  agentExecutions  AgentExecution[]
  scoutScans       ScoutScan[]
  attackPlans      AttackPlan[]
  exploits         Exploit[]
  runtimeSandboxes RuntimeSandbox[]

  @@index([status])
  @@index([createdAt])
  @@map("scans")
}

/// Source code repository being scanned
model Repository {
  id         String             @id @default(cuid())
  name       String
  url        String
  provider   RepositoryProvider @default(GITHUB)
  branch     String             @default("main")
  language   String?
  isPrivate  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  scans ScanRepository[]

  @@unique([url, branch])
  @@index([provider])
  @@map("repositories")
}

/// Join table: Scan <-> Repository (many-to-many)
model ScanRepository {
  id           String   @id @default(cuid())
  scanId       String
  repositoryId String
  createdAt    DateTime @default(now())

  scan       Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([scanId, repositoryId])
  @@map("scan_repositories")
}

/// Runtime application sandboxes provisioned for a scan (Phase 6).
/// Never raw Docker handles in the API — the manager-owned ids here are the
/// lifecycle's connection to its infrastructure; agents receive contexts.
model RuntimeSandbox {
  id             String                @id @default(cuid())
  scanId         String
  status         RuntimeSandboxStatus  @default(CREATING)
  name           String?
  /// Repository reference that was provisioned (URL xor path).
  repositoryUrl  String?
  repositoryPath String?
  /// Manager-side sandbox id of the running app container (agents consume this).
  sandboxId      String?
  imageId        String?
  imageName      String?
  /// Scan-scoped internal network id.
  networkId      String?
  targetUrl      String?
  internalHost   String?
  internalPort   Int?
  exposedPort    Int?
  /// Ephemeral build workspace (removed with the sandbox).
  workspacePath  String?
  failureStage   String?
  failureReason  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  expiresAt      DateTime?
  destroyedAt    DateTime?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([status])
  @@index([expiresAt])
  @@map("runtime_sandboxes")
}

/// Detected security vulnerability
model Vulnerability {
  id          String                @id @default(cuid())
  scanId      String
  title       String
  description String?
  severity    VulnerabilitySeverity @default(MEDIUM)
  status      VulnerabilityStatus   @default(DETECTED)
  filePath    String?
  lineNumber  Int?
  cweId       String?
  cveRecordId String?
  /// Scanner that produced this finding (Static Scanner phase).
  scanner     String?
  /// Vulnerability type/code as reported by the scanner.
  vulnType    String?
  /// Scanner confidence (0..1); never a security decision.
  confidence  Float?
  message     String?
  /// Raw CVE identifier when reported by the scanner.
  cve         String?
  /// Advisory references (URLs / aliases).
  references  Json?
  /// Evidence snippet.
  evidence    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  scan      Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  cveRecord CVERecord? @relation(fields: [cveRecordId], references: [id])
  exploits  Exploit[]
  patches   Patch[]

  @@index([scanId])
  @@index([severity])
  @@index([status])
  @@index([scanner])
  @@index([cveRecordId])
  @@map("vulnerabilities")
}

/// Exploitability confirmation for a vulnerability (Sniper Agent output).
/// One row per verified planned target; `status` is the FINAL verdict while
/// each attempt is recorded separately in `VerificationAttempt`.
model Exploit {
  id            String        @id @default(cuid())
  /// Planner-synthesized target id (`PlannedAttackTarget.targetId`).
  targetId      String?
  scanId        String
  /// Optional link to the static finding this PoC correlates with.
  vulnerabilityId String?
  endpoint      String
  method        String        @default("GET")
  /// Canonical vulnerability type (e.g. "SQL_INJECTION").
  vulnerabilityType String?
  /// Verified parameter name when the tool pinpoints one.
  parameter     String?
  /// Verification tool that produced the final status (e.g. "sqlmap").
  tool          String?
  status        ExploitStatus @default(NOT_TESTED)
  /// Explainable confidence (0..1) — never an LLM guess.
  confidence    Float?
  /// Weighted evidence factors that produced `confidence`.
  confidenceBreakdown Json?
  /// Short human-readable reason for the status.
  statusReason  String?
  /// Redacted tool output summary (no full HTTP responses).
  toolSummary   String?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  vulnerability Vulnerability?     @relation(fields: [vulnerabilityId], references: [id], onDelete: SetNull)
  scan          Scan               @relation(fields: [scanId], references: [id], onDelete: Cascade)
  attempts      VerificationAttempt[]
  evidence      ExploitEvidence[]

  @@index([targetId])
  @@index([scanId])
  @@index([vulnerabilityId])
  @@index([status])
  @@map("exploits")
}

/// One individual verification attempt for an Exploit (a vulnerability may
/// have many). Final status lives on `Exploit`; this is the per-run record.
model VerificationAttempt {
  id            String        @id @default(cuid())
  exploitId     String
  attemptNumber Int           @default(1)
  /// Verifier that ran (e.g. "sql-injection") and the tool it drove.
  verifier      String
  tool          String?
  /// Per-attempt state (TESTING/CONFIRMED/NOT_CONFIRMED/INCONCLUSIVE/FAILED).
  status        ExploitStatus
  /// Parsed, redacted evidence (injection point, technique, payload, ...).
  evidence      Json?
  /// Truncated + redacted stdout (never full responses).
  stdout        String?
  stderr        String?
  errorMessage  String?
  exitCode      Int?
  timedOut      Boolean       @default(false)
  retried       Boolean       @default(false)
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  createdAt     DateTime      @default(now())

  exploit Exploit @relation(fields: [exploitId], references: [id], onDelete: Cascade)

  @@index([exploitId])
  @@index([status])
  @@map("verification_attempts")
}

/// Structured evidence items backing an Exploit verdict — enough for a
/// reviewer to re-derive the classification without raw responses.
model ExploitEvidence {
  id               String   @id @default(cuid())
  exploitId        String
  /// Machine-readable indicator (e.g. "sqlmap:injection_point").
  indicator        String
  /// Evidence category (tool_confirmation / reproducibility / ...).
  category         String
  httpStatus       Int?
  /// Redacted snippet or observation.
  detail           String?
  /// 0..1 weight this item contributes to confidence.
  confidenceFactor Float    @default(0)
  createdAt        DateTime @default(now())

  exploit Exploit @relation(fields: [exploitId], references: [id], onDelete: Cascade)

  @@index([exploitId])
  @@map("exploit_evidence")
}

/// AI-generated patch for a vulnerability (Engineer Agent output)
model Patch {
  id              String      @id @default(cuid())
  vulnerabilityId String
  status          PatchStatus @default(GENERATED)
  diffContent     String?
  filePath        String?
  explanation     String?
  validatedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  criticRuns CriticRun[]

  @@index([vulnerabilityId])
  @@index([status])
  @@map("patches")
}

/// Execution record for an autonomous agent run
/// Critic Agent (Phase 8) — one validation run over an Engineer patch.
/// Rows are created per attempt; attempts are never overwritten.
model CriticRun {
  id              String       @id @default(cuid())
  patchId         String
  vulnerabilityId String
  scanId          String?
  executionId     String?
  attempt         Int          @default(1)
  status          CriticStatus
  failureReason   String?
  checks          Json?
  exploitResult   Json?
  feedback        Json?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  patch Patch @relation(fields: [patchId], references: [id], onDelete: Cascade)

  @@index([patchId])
  @@index([vulnerabilityId])
  @@index([executionId])
  @@map("critic_runs")
}

model AgentExecution {
  id           String               @id @default(cuid())
  scanId       String
  agentType    AgentType
  status       AgentExecutionStatus @default(PENDING)
  input        Json?
  output       Json?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([agentType])
  @@index([status])
  @@map("agent_executions")
}

/// CVE (Common Vulnerabilities and Exposures) reference record
model CVERecord {
  id          String    @id @default(cuid())
  cveId       String    @unique
  description String?
  severity    VulnerabilitySeverity?
  cvssScore   Float?
  cvssVector  String?
  publishedAt DateTime?
  modifiedAt  DateTime?
  references  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vulnerabilities Vulnerability[]

  @@index([cveId])
  @@index([severity])
  @@map("cve_records")
}

/// Scout Agent: one reconnaissance run against a running application
/// (attached to the source `Scan` that produced the repository under test).
model ScoutScan {
  id          String      @id @default(cuid())
  scanId      String
  targetUrl   String
  status      ScoutStatus @default(PENDING)
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  /// Recon summary (AttackSurfaceReport.summary).
  summary     Json?
  createdAt   DateTime    @default(now())

  scan         Scan                   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  surfaces     ScoutAttackSurface[]
  technologies ScoutTechnology[]
  services     ScoutService[]
  ports        ScoutPort[]

  @@index([scanId])
  @@index([status])
  @@map("scout_scans")
}

enum ScoutStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// One discovered attack-surface target (url + method + params + auth + risk).
/// This is the persisted Endpoint record enriched with risk/reachability.
model ScoutAttackSurface {
  id             String   @id @default(cuid())
  scoutScanId    String
  url            String
  method         String   @default("GET")
  /// Parsed parameter names (query string + form inputs).
  parameters     Json?
  authentication Boolean  @default(false)
  /// Technology names attributed to this endpoint.
  technology     Json?
  risk           String   @default("LOW")
  source         String   @default("crawler")
  reachable      Boolean  @default(true)
  statusCode     Int?
  createdAt      DateTime @default(now())

  scoutScan ScoutScan @relation(fields: [scoutScanId], references: [id], onDelete: Cascade)

  @@index([scoutScanId])
  @@map("scout_attack_surfaces")
}

/// Technology detected during fingerprinting.
model ScoutTechnology {
  id          String   @id @default(cuid())
  scoutScanId String
  name        String
  category    String   @default("unknown")
  version     String?
  confidence  Float    @default(1)
  evidence    String?
  createdAt   DateTime @default(now())

  scoutScan ScoutScan @relation(fields: [scoutScanId], references: [id], onDelete: Cascade)

  @@index([scoutScanId])
  @@map("scout_technologies")
}

/// Service discovered during recon (e.g. http, ssh, postgres).
model ScoutService {
  id          String   @id @default(cuid())
  scoutScanId String
  name        String
  protocol    String   @default("tcp")
  port        Int?
  version     String?
  evidence    String?
  createdAt   DateTime @default(now())

  scoutScan ScoutScan @relation(fields: [scoutScanId], references: [id], onDelete: Cascade)

  @@index([scoutScanId])
  @@map("scout_services")
}

/// Open port discovered during recon.
model ScoutPort {
  id          String   @id @default(cuid())
  scoutScanId String
  port        Int
  protocol    String   @default("tcp")
  state       String   @default("open")
  service     String?
  createdAt   DateTime @default(now())

  scoutScan ScoutScan @relation(fields: [scoutScanId], references: [id], onDelete: Cascade)

  @@index([scoutScanId])
  @@map("scout_ports")
}

/// Attack Planner (M14): a prioritized, explained attack plan for a scan.
/// Reasoning-only — nothing is executed from here.
model AttackPlan {
  id              String   @id @default(cuid())
  scanId          String
  createdAt       DateTime @default(now())
  coveredSurfaces Int      @default(0)
  coveredFindings Int      @default(0)
  /// Summary counts (targets / critical / high / medium / low).
  summary         Json?
  targets         PlannedTarget[]

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([createdAt])
  @@map("attack_plans")
}

/// One ranked attack-surface target inside a plan.
model PlannedTarget {
  id                        String   @id @default(cuid())
  planId                    String
  scanId                    String
  /// Synthesized planner id, distinct from this row's primary key.
  targetId                  String
  vulnerabilityId           String?
  endpoint                  String
  method                    String   @default("GET")
  /// Candidate vulnerability hypotheses the planner raised.
  candidateVulnerabilities  Json?
  /// Preliminary priority 0–100 (higher = test sooner).
  priority                  Int      @default(0)
  recommendedTool           String   @default("none")
  reason                    String
  requiresAuthentication    Boolean  @default(false)
  estimatedRisk             String   @default("LOW")
  /// Transparent score accounting (label + points per factor).
  breakdown                 Json?
  /// Target verification hints (parameter names, upload fields, locations, auth context).
  verificationHints         Json?
  createdAt                 DateTime @default(now())

  plan AttackPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([scanId])
  @@index([vulnerabilityId])
  @@map("planned_attack_targets")
}
