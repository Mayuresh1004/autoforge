{
  "name": "@amass/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AMASS Backend API - Express TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
