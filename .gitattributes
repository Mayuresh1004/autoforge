# Line-ending policy: the repo is LF-native. On Windows, `* text=auto` would
# convert checked-out text to CRLF — fine for code, fatal for shell scripts —
# so shell + build configs are pinned to LF. Set your Git for Windows
# `core.autocrlf` to `input` (or `true` with this file in place).
* text=auto

*.sh      text eol=lf
*.bash    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.prisma  text eol=lf
Dockerfile        text eol=lf
Dockerfile.*      text eol=lf
*.dockerfile      text eol=lf
